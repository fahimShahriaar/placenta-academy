# Database (matches the Docker command in README.md)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placenta_academy"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Uploads (sizes in bytes: 50 MB / 5 MB)
UPLOAD_DIR="./uploads"
MAX_PDF_SIZE=52428800
MAX_IMAGE_SIZE=5242880

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Placenta Academy"
